# The class documentation of swarm-adapter-ns3 (swarm-routing/.github#881,
# swarm-routing/.github#883; the standard: swarm-routing/.github CONTRIBUTING
# "Class documentation and install guide"): the org-sync seed, now this
# repository's own. CI builds it on every PR (the org-managed
# .github/workflows/api-docs.yml, reusable-doxygen.yml) and the site publishes
# it at /swarm-adapter-ns3/api/. INPUT is the public API: the module's model/
# and helper/ headers (at the repository root, not under ns3/), with its own
# main page; never tests/ or examples/.
# Locally: PROJECT_VERSION=dev doxygen docs/api/Doxyfile
PROJECT_NAME           = "swarm-adapter-ns3"
PROJECT_NUMBER         = $(PROJECT_VERSION)
OUTPUT_DIRECTORY       = build/api
CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = build/api/warnings.log
INPUT                  = docs/api/mainpage.md \
                         model \
                         helper
FILE_PATTERNS          = *.h *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */test/* */tests/* */examples/* */build/*
USE_MDFILE_AS_MAINPAGE = docs/api/mainpage.md
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = TOGGLE
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
